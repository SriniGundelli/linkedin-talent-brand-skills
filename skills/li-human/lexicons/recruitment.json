  "structures": [
    {
      "id": "unpaid-range",
      "regex": "(?i)\\\\b(salary|compensation|pay)\\\\b[^.\\\\n]{0,20}\\\\b(dom|doe|negotiable|competitive|commensurate)\\\\b",
      "name": "No pay figure",
      "fix": "Give the range. Pay-transparency laws now require it in many places, and candidates skip roles without one."
    },
    {
      "id": "requirement-wall",
      "regex": "(?i)\\\\b(\\\\d{2}\\\\+ years|10\\\\+ years|must have all of)\\\\b",
      "name": "Requirement wall",
      "fix": "Cut to the 4-5 things the person needs on day one. Long lists screen out strong candidates who match fewer than all of them."
    }
  ]
